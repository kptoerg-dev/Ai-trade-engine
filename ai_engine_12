# DATA DOWNLOAD
# ============================================================

def _flatten_yf_columns(df: pd.DataFrame) -> pd.DataFrame:

    if isinstance(df.columns, pd.MultiIndex):

        level0 = [
            str(x)
            for x in df.columns.get_level_values(0)
        ]

        fields = {
            "Open",
            "High",
            "Low",
            "Close",
            "Adj Close",
            "Volume",
        }

        if any(x in fields for x in level0):

            df = df.copy()

            df.columns = (
                df.columns
                .get_level_values(0)
            )

        else:

            df = df.copy()

            df.columns = (
                df.columns
                .get_level_values(-1)
            )

    return df


def download_ohlcv(
    ticker: str,
    start: str,
    end: str
) -> pd.DataFrame:

    raw = yf.download(
        ticker,
        start=start,
        end=end,
        auto_adjust=True,
        progress=False,
        threads=False,
    )

    raw = _flatten_yf_columns(raw)

    needed = [
        "Open",
        "High",
        "Low",
        "Close",
        "Volume",
    ]

    missing = [
        c
        for c in needed
        if c not in raw.columns
    ]

    if missing:

        raise ValueError(
            f"{ticker}: missing columns {missing}"
        )

    out = raw[needed].copy()

    out.columns = [
        c.lower()
        for c in out.columns
    ]

    out = out.dropna(
        subset=[
            "open",
            "high",
            "low",
            "close",
        ]
    )

    out.index = pd.to_datetime(
        out.index
    ).tz_localize(None)

    out = out[
        ~out.index.duplicated(
            keep="last"
        )
    ]

    out["ticker"] = ticker
    out["date"] = out.index

    return out.reset_index(
        drop=True
    )


# ============================================================
# ATR
# ============================================================

def calculate_atr(
    df: pd.DataFrame,
    n: int = 14
) -> pd.Series:

    previous_close = df["close"].shift(1)

    true_range = pd.concat(
        [
            df["high"] - df["low"],

            (
                df["high"]
                - previous_close
            ).abs(),

            (
                df["low"]
                - previous_close
            ).abs(),
        ],
        axis=1,
    ).max(axis=1)

    return true_range.ewm(
        alpha=1 / n,
        adjust=False,
        min_periods=n,
    ).mean()


# ============================================================
# FEATURE ENGINEERING
# ============================================================

def make_features(
    df: pd.DataFrame,
    benchmark: Optional[pd.DataFrame] = None,
) -> pd.DataFrame:

    x = (
        df
        .sort_values("date")
        .copy()
    )

    close = x["close"]
    high = x["high"]
    low = x["low"]
    open_ = x["open"]
    volume = x["volume"]

    # --------------------------------------------------------
    # Returns
    # --------------------------------------------------------

    x["ret_1"] = close.pct_change()
    x["ret_3"] = close.pct_change(3)
    x["ret_5"] = close.pct_change(5)
    x["ret_10"] = close.pct_change(10)
    x["ret_20"] = close.pct_change(20)
    x["ret_60"] = close.pct_change(60)

    # --------------------------------------------------------
    # Volatility
    # --------------------------------------------------------

    x["vol_10"] = (
        x["ret_1"]
        .rolling(10)
        .std()
    )

    x["vol_20"] = (
        x["ret_1"]
        .rolling(20)
        .std()
    )

    x["vol_60"] = (
        x["ret_1"]
        .rolling(60)
        .std()
    )

    # --------------------------------------------------------
    # ATR
    # --------------------------------------------------------

    x["atr_14"] = calculate_atr(
        x,
        14
    )

    x["atr_pct"] = (
        x["atr_14"]
        / close.replace(0, np.nan)
    )

    # --------------------------------------------------------
    # Moving averages
    # --------------------------------------------------------

    ma10 = close.rolling(10).mean()
    ma20 = close.rolling(20).mean()
    ma50 = close.rolling(50).mean()
    ma100 = close.rolling(100).mean()
    ma200 = close.rolling(200).mean()

    x["dist_ma10"] = (
        close / ma10 - 1
    )

    x["dist_ma20"] = (
        close / ma20 - 1
    )

    x["dist_ma50"] = (
        close / ma50 - 1
    )

    x["dist_ma100"] = (
        close / ma100 - 1
    )

    x["dist_ma200"] = (
        close / ma200 - 1
    )

    # --------------------------------------------------------
    # RSI
    # --------------------------------------------------------

    delta = close.diff()

    gain = (
        delta
        .clip(lower=0)
        .rolling(14)
        .mean()
    )

    loss = (
        -delta
        .clip(upper=0)
        .rolling(14)
        .mean()
    )

    rs = (
        gain
        / loss.replace(
            0,
            np.nan
        )
    )

    x["rsi_14"] = (
        100
        - 100 / (1 + rs)
    )

    # --------------------------------------------------------
    # Candle structure
    # --------------------------------------------------------

    x["range_pct"] = (
        (high - low)
        / close.replace(0, np.nan)
    )

    x["body_pct"] = (
        (close - open_)
        / open_.replace(0, np.nan)
    )

    x["upper_wick"] = (
        high
        - np.maximum(
            open_,
            close
        )
    ) / close.replace(
        0,
        np.nan
    )

    x["lower_wick"] = (
        np.minimum(
            open_,
            close
        )
        - low
    ) / close.replace(
        0,
        np.nan
    )

    # --------------------------------------------------------
    # Volume
    # --------------------------------------------------------

    log_volume = np.log1p(
        volume.clip(lower=0)
    )

    volume_mean = (
        log_volume
        .rolling(20)
        .mean()
    )

    volume_std = (
        log_volume
        .rolling(20)
        .std()
    )

    x["volume_z20"] = (
        log_volume
        - volume_mean
    ) / volume_std

    x["volume_change"] = (
        volume
        .pct_change()
        .replace(
            [np.inf, -np.inf],
            np.nan
        )
    )

    # --------------------------------------------------------
    # Momentum / trend
    # --------------------------------------------------------

    x["momentum_accel"] = (
        x["ret_5"]
        - x["ret_20"] / 4
    )

    x["trend_strength"] = (
        ma20 - ma100
    ) / ma100

    x["breakout_20"] = (
        close
        / high.shift(1)
        .rolling(20)
        .max()
        - 1
    )

    x["drawdown_60"] = (
        close
        / close.rolling(60).max()
        - 1
    )

    # --------------------------------------------------------
    # Seasonality
    # --------------------------------------------------------

    dow = x["date"].dt.dayofweek
    month = x["date"].dt.month

    x["dow_sin"] = np.sin(
        2 * np.pi * dow / 5
    )

    x["dow_cos"] = np.cos(
        2 * np.pi * dow / 5
    )

    x["month_sin"] = np.sin(
        2 * np.pi * month / 12
    )

    x["month_cos"] = np.cos(
        2 * np.pi * month / 12
    )

    # --------------------------------------------------------
    # Benchmark / relative strength
    # --------------------------------------------------------

    if benchmark is not None:

        b = (
            benchmark[
                ["date", "close"]
            ]
            .rename(
                columns={
                    "close":
                    "bench_close"
                }
            )
            .sort_values("date")
        )

        x = pd.merge_asof(
            x.sort_values("date"),
            b.sort_values("date"),
            on="date",
            direction="backward",
        )

        x["bench_ret_5"] = (
            x["bench_close"]
            .pct_change(5)
        )

        x["bench_ret_20"] = (
            x["bench_close"]
            .pct_change(20)
        )

        asset_return = (
            x["close"]
            .pct_change()
        )

        benchmark_return = (
            x["bench_close"]
            .pct_change()
        )

        x["rel_strength_20"] = (
            x["ret_20"]
            - x["bench_ret_20"]
        )

        x["beta_60"] = (
            asset_return
            .rolling(60)
            .cov(
                benchmark_return
            )
            /
            benchmark_return
            .rolling(60)
            .var()
        )

        x["corr_60"] = (
            asset_return
            .rolling(60)
            .corr(
                benchmark_return
            )
        )

    return (
        x
        .replace(
            [np.inf, -np.inf],
            np.nan
        )
    )


# ============================================================
# LABELS
# ============================================================

def make_labels(
    df: pd.DataFrame,
    horizon: int,
    atr_stop: float,
    atr_target: float,
) -> pd.DataFrame:

    x = (
        df
        .sort_values(
            ["ticker", "date"]
        )
        .copy()
    )

    parts = []

    for ticker, group in x.groupby(
        "ticker",
        sort=False
    ):

        g = (
            group
            .sort_values("date")
            .reset_index(
                drop=True
            )
            .copy()
        )

        opens = g["open"].to_numpy(
            float
        )

        highs = g["high"].to_numpy(
            float
        )

        lows = g["low"].to_numpy(
            float
        )

        closes = g["close"].to_numpy(
            float
        )

        atr = g["atr_14"].to_numpy(
            float
        )

        dates = g["date"].to_numpy()

        labels = np.full(
            len(g),
            np.nan
        )

        target_returns = np.full(
            len(g),
            np.nan
        )

        exit_dates = np.full(
            len(g),
            np.datetime64("NaT"),
            dtype="datetime64[ns]"
        )

        for i in range(
            len(g) - 1
        ):

            # Entry = next bar open
            entry = opens[i + 1]

            if (
                not np.isfinite(entry)
                or not np.isfinite(atr[i])
                or entry <= 0
            ):
                continue

            end = min(
                len(g) - 1,
                i + horizon + 1
            )

            stop = (
                entry
                - atr_stop * atr[i]
            )

            target = (
                entry
                + atr_target * atr[i]
            )

            result = None
            exit_i = end

            for j in range(
                i + 1,
                end + 1
            ):

                # Conservative:
                # stop before target if both
                # are hit in the same candle.
                if lows[j] <= stop:

                    result = (
                        stop / entry
                        - 1
                    )

                    exit_i = j
                    break

                if highs[j] >= target:

                    result = (
                        target / entry
                        - 1
                    )

                    exit_i = j
                    break

            if result is None:

                result = (
                    closes[end]
                    / entry
                    - 1
                )

            labels[i] = (
                1.0
                if result > 0
                else 0.0
            )

            target_returns[i] = result

            exit_dates[i] = dates[
                exit_i
            ]

        g["label"] = labels

        g["target_return"] = (
            target_returns
        )

        g["label_exit"] = (
            pd.to_datetime(
                exit_dates
            )
        )

        parts.append(g)

    return pd.concat(
        parts,
        ignore_index=True
    )


