def get_feature_columns(
    df: pd.DataFrame
) -> List[str]:

    exclude = {
        "date",
        "ticker",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "label",
        "target_return",
        "label_exit",
        "exec_date",
        "bench_close",
    }

    return [
        c
        for c in df.columns
        if c not in exclude
        and pd.api.types.is_numeric_dtype(
            df[c]
        )
    ]


# ============================================================
# FOLD-LOCAL FEATURE SELECTION
# ============================================================

def _select_features(
    X: pd.DataFrame,
    y: pd.Series,
    min_features: int = 8,
) -> List[str]:

    features = list(X.columns)

    pipeline = Pipeline(
        [
            (
                "imputer",
                SimpleImputer(
                    strategy="median"
                ),
            ),

            (
                "scaler",
                StandardScaler()
            ),

            (
                "selector",
                LogisticRegression(
                    penalty="l1",
                    solver="liblinear",
                    C=0.08,
                    class_weight="balanced",
                    max_iter=1500,
                    random_state=42,
                ),
            ),
        ]
    )

    pipeline.fit(
        X[features],
        y.astype(int)
    )

    coefficients = np.abs(
        pipeline
        .named_steps["selector"]
        .coef_[0]
    )

    if not np.isfinite(
        coefficients
    ).any():

        return features[
            :min(
                16,
                len(features)
            )
        ]

    positive = coefficients[
        coefficients > 0
    ]

    if len(positive):

        threshold = np.nanmedian(
            positive
        )

    else:

        threshold = 0

    selected = [
        feature
        for feature, weight
        in zip(
            features,
            coefficients
        )
        if (
            weight >= threshold
            and weight > 0
        )
    ]

    if len(selected) < min_features:

        order = np.argsort(
            -coefficients
        )

        selected = [
            features[i]
            for i in order[
                :min(
                    min_features,
                    len(features)
                )
            ]
        ]

    return selected


# ============================================================
# CALIBRATION
# ============================================================

def _fit_calibrator(
    raw: np.ndarray,
    y: np.ndarray
):

    raw = np.asarray(
        raw,
        float
    )

    y = np.asarray(
        y,
        int
    )

    if (
        len(np.unique(y)) < 2
        or len(raw) < 30
    ):

        return None

    try:

        calibrator = (
            IsotonicRegression(
                out_of_bounds="clip"
            )
        )

        calibrator.fit(
            raw,
            y
        )

        return calibrator

    except Exception:

        return None


# ============================================================
# MODEL TRAINING
# ============================================================

def train_models(
    train: pd.DataFrame,
    features: List[str],
    cfg: Config,
):

    train = train.dropna(
        subset=[
            "label",
            "target_return",
        ]
    ).copy()

    if (
        len(train)
        < cfg.min_train_rows
    ):

        raise ValueError(
            "Insufficient training data: "
            f"{len(train)} rows"
        )

    if train["label"].nunique() < 2:

        raise ValueError(
            "Training data contains "
            "only one label class."
        )

    # --------------------------------------------------------
    # Chronological calibration split
    # --------------------------------------------------------

    split = max(
        int(len(train) * 0.82),
        1
    )

    base = train.iloc[
        :split
    ].copy()

    calibration = train.iloc[
        split:
    ].copy()

    if len(calibration) < 30:

        base = train.iloc[
            :-30
        ].copy()

        calibration = train.iloc[
            -30:
        ].copy()

    # --------------------------------------------------------
    # Feature selection ONLY on training data
    # --------------------------------------------------------

    selected_features = (
        _select_features(
            base[features],
            base["label"]
        )
    )

    X_base = base[
        selected_features
    ]

    y_base = base[
        "label"
    ].astype(int)

    # --------------------------------------------------------
    # CLASSIFIER
    # --------------------------------------------------------

    classifier = Pipeline(
        [
            (
                "imputer",
                SimpleImputer(
                    strategy="median"
                ),
            ),

            (
                "model",
                HistGradientBoostingClassifier(
                    max_iter=cfg.max_iter,
                    learning_rate=0.045,
                    max_leaf_nodes=15,
                    l2_regularization=1.0,
                    random_state=cfg.random_state,
                ),
            ),
        ]
    )

    # --------------------------------------------------------
    # EXPECTED RETURN REGRESSOR
    #
    # IMPORTANT:
    # absolute_error is compatible with current
    # scikit-learn versions.
    # --------------------------------------------------------

    regressor = Pipeline(
        [
            (
                "imputer",
                SimpleImputer(
                    strategy="median"
                ),
            ),

            (
                "model",
                HistGradientBoostingRegressor(
                    max_iter=cfg.max_iter,
                    learning_rate=0.045,
                    max_leaf_nodes=15,
                    l2_regularization=1.0,
                    loss="absolute_error",
                    random_state=cfg.random_state,
                ),
            ),
        ]
    )

    classifier.fit(
        X_base,
        y_base
    )

    regressor.fit(
        X_base,
        base[
            "target_return"
        ].astype(float)
    )

    # --------------------------------------------------------
    # Probability calibration
    # --------------------------------------------------------

    calibrator = None

    if len(calibration) >= 30:

        raw_probability = (
            classifier
            .predict_proba(
                calibration[
                    selected_features
                ]
            )[:, 1]
        )

        calibrator = _fit_calibrator(
            raw_probability,
            calibration[
                "label"
            ].astype(int)
            .to_numpy()
        )

    return {
        "clf": classifier,
        "reg": regressor,
        "features": selected_features,
        "calibrator": calibrator,
    }


# ============================================================
# PREDICTION
# ============================================================

def predict_models(
    model_bundle,
    data: pd.DataFrame,
) -> pd.DataFrame:

    x = data.copy()

    features = (
        model_bundle["features"]
    )

    raw_probability = (
        model_bundle["clf"]
        .predict_proba(
            x[features]
        )[:, 1]
    )

    calibrator = (
        model_bundle["calibrator"]
    )

    if calibrator is not None:

        probability = (
            calibrator
            .predict(
                raw_probability
            )
        )

    else:

        probability = (
            raw_probability
        )

    expected_return = (
        model_bundle["reg"]
        .predict(
            x[features]
        )
    )

    volatility = (
        x["vol_20"]
        .clip(lower=0.002)
        .fillna(0.03)
        .to_numpy()
    )

    x["prob_up"] = np.clip(
        probability,
        0.001,
        0.999
    )

    x["raw_prob_up"] = (
        raw_probability
    )

    x["expected_return"] = (
        expected_return
    )

    # Risk-adjusted opportunity score
    x["score"] = (
        expected_return
        * (0.5 + x["prob_up"])
        / volatility
    )

    return x


# ============================================================
# WALK FORWARD FOLDS
# ============================================================

def _fold_starts(
    dates: pd.DatetimeIndex,
    cfg: Config,
):

    dates = pd.DatetimeIndex(
        sorted(
            pd.unique(dates)
        )
    )

    folds = []

    position = cfg.train_days

    while position < len(dates):

        train_start = dates[
            max(
                0,
                position
                - cfg.train_days
            )
        ]

        test_start = dates[
            position
        ]

        test_end_position = min(
            position
            + cfg.test_days
            - 1,
            len(dates) - 1
        )

        test_end = dates[
            test_end_position
        ]

        folds.append(
            (
                train_start,
                test_start,
                test_end,
            )
        )

        position += (
            cfg.step_days
        )

    return folds


# ============================================================
# PURGED WALK FORWARD
# ============================================================

def walk_forward(
    panel: pd.DataFrame,
    cfg: Config,
):

    panel = (
        panel
        .sort_values(
            ["date", "ticker"]
        )
        .copy()
    )

    all_dates = pd.DatetimeIndex(
        sorted(
            panel["date"]
            .dropna()
            .unique()
        )
    )

    folds = _fold_starts(
        all_dates,
        cfg
    )

    predictions = []
    diagnostics = []

    for fold_id, (
        train_start,
        test_start,
        test_end,
    ) in enumerate(
        folds,
        1
    ):

        # ----------------------------------------------------
        # TRAINING WINDOW
        # ----------------------------------------------------

        train = panel[
            (panel["date"] >= train_start)
            &
            (panel["date"] < test_start)
        ].copy()

        # ----------------------------------------------------
        # PURGE
        #
        # Any observation whose future label window reaches
        # into the OOS period is removed.
        # ----------------------------------------------------

        train = train[
            train["label_exit"]
            < test_start
        ]

        # Explicit additional purge buffer
        if cfg.purge_days > 0:

            purge_boundary = (
                test_start
                - pd.Timedelta(
                    days=cfg.purge_days
                )
            )

            train = train[
                train["date"]
                < purge_boundary
            ]

        # ----------------------------------------------------
        # TEST WINDOW
        # ----------------------------------------------------

        test = panel[
            (panel["date"] >= test_start)
            &
            (panel["date"] <= test_end)
        ].copy()

        diagnostic = {

            "fold": fold_id,

            "train_start":
                train_start,

            "test_start":
                test_start,

            "test_end":
                test_end,

            "train_rows":
                len(train),

            "test_rows":
                len(test),

            "status":
                "skipped",

            "reason":
                "",

            "selected_features":
                0,

            "auc":
                np.nan,
        }

        # ----------------------------------------------------
        # VALIDATION
        # ----------------------------------------------------

        if (
            len(train)
            < cfg.min_train_rows
        ):

            diagnostic["reason"] = (
                f"training rows "
                f"{len(train)} < "
                f"min_train_rows "
                f"{cfg.min_train_rows}"
            )

            diagnostics.append(
                diagnostic
            )

            continue

        if (
            len(test)
            < cfg.min_test_rows
        ):

            diagnostic["reason"] = (
                f"test rows "
                f"{len(test)} < "
                f"min_test_rows "
                f"{cfg.min_test_rows}"
            )

            diagnostics.append(
                diagnostic
            )

            continue

        # ----------------------------------------------------
        # TRAIN
        # ----------------------------------------------------

        try:

            features = (
                get_feature_columns(
                    train
                )
            )

            bundle = train_models(
                train,
                features,
                cfg
            )

            diagnostic[
                "selected_features"
            ] = len(
                bundle["features"]
            )

            # ------------------------------------------------
            # OOS PREDICTION
            # ------------------------------------------------

            prediction = (
                predict_models(
                    bundle,
                    test
                )
            )

            prediction["fold"] = (
                fold_id
            )

            # ------------------------------------------------
            # IMPORTANT:
            #
            # Signal on day t
            # Entry on next available bar
            # of SAME ticker.
            # ------------------------------------------------

            prediction[
                "exec_date"
            ] = (
                prediction
                .sort_values(
                    ["ticker", "date"]
                )
                .groupby(
                    "ticker"
                )["date"]
                .shift(-1)
            )

            prediction = (
                prediction
                .dropna(
                    subset=[
                        "exec_date"
                    ]
                )
                .copy()
            )

            if prediction.empty:

                diagnostic[
                    "reason"
                ] = (
                    "No rows with a "
                    "next available "
                    "execution bar."
                )

                diagnostics.append(
                    diagnostic
                )

                continue

            # ------------------------------------------------
            # AUC
            # ------------------------------------------------

            valid_auc = (
                prediction[
                    "label"
                ].notna()
            )

            y = prediction.loc[
                valid_auc,
                "label"
            ]

            if (
                len(y) > 0
                and y.nunique() == 2
            ):

                try:

                    diagnostic["auc"] = (
                        roc_auc_score(
                            y,
                            prediction.loc[
                                valid_auc,
                                "prob_up"
                            ]
                        )
                    )

                except Exception:
                    pass

            diagnostic[
                "status"
            ] = "ok"

            diagnostics.append(
                diagnostic
            )

            predictions.append(
                prediction
            )

        except Exception as exc:

            diagnostic[
                "reason"
            ] = (
                f"{type(exc).__name__}: "
                f"{exc}"
            )

            diagnostics.append(
                diagnostic
            )

    # --------------------------------------------------------
    # FINAL RESULT
    # --------------------------------------------------------

    if not predictions:

        diagnostics_df = pd.DataFrame(
            diagnostics
        )

        reasons = "; ".join(
            diagnostics_df[
                "reason"
            ]
            .dropna()
            .astype(str)
            .head(8)
            .tolist()
        )

        raise RuntimeError(
            "No walk-forward predictions "
            "were produced. "
            f"Fold diagnostics: "
            f"{reasons or 'no valid folds'}"
        )

    return (
        pd.concat(
            predictions,
            ignore_index=True
        ),
        pd.DataFrame(
            diagnostics
        ),
    )


# ============================================================
# COST MODEL
# ============================================================

def _cost_rate(
    cfg: Config
) -> float:

    return (
        cfg.commission_bps
        + cfg.slippage_bps
    ) / 10000.0


# ============================================================
# FRACTIONAL KELLY
# ============================================================

def _kelly_risk(
    recent_returns: List[float],
    edge_hint: float,
    cfg: Config,
) -> float:

    if len(recent_returns) < 10:

        base_risk = 0.012

    else:

        wins = [
            x
            for x in recent_returns
            if x > 0
        ]

        losses = [
            -x
            for x in recent_returns
            if x < 0
        ]

        if not wins or not losses:

            base_risk = 0.012

        else:

            win_probability = (
                len(wins)
                / len(recent_returns)
            )

            win_loss_ratio = (
                np.mean(wins)
                /
                max(
                    np.mean(losses),
                    1e-9
                )
            )

            kelly = (
                win_probability
                -
                (
                    1
                    - win_probability
                )
                / max(
                    win_loss_ratio,
                    1e-9
                )
            )

            base_risk = (
                max(
                    0.0,
                    kelly
                )
                * cfg.kelly_fraction
            )

    # Slightly reward stronger expected edge
    base_risk *= np.clip(
        1 + edge_hint * 5,
        0.5,
        1.5
    )

    return float(
        np.clip(
            base_risk,
            cfg.risk_fraction_min,
            cfg.risk_fraction_max,
        )
    )


# ============================================================
# BACKTEST
# ============================================================

def backtest(
    predictions: pd.DataFrame,
    panel: pd.DataFrame,
    cfg: Config,
):

    predictions = (
        predictions.copy()
    )

    predictions["exec_date"] = (
        pd.to_datetime(
            predictions[
                "exec_date"
            ]
        )
    )

    bars = (
        panel
        .sort_values(
            ["date", "ticker"]
        )
        .copy()
    )

    market_dates = (
        pd.DatetimeIndex(
            sorted(
                bars["date"].unique()
            )
        )
    )

    cash = float(
        cfg.initial_capital
    )

    positions: Dict[
        str,
        Dict
    ] = {}

    trades = []

    equity_rows = []

    recent_returns = []

    grouped = {
        ticker:
            group
            .sort_values("date")
            .reset_index(
                drop=True
            )
        for ticker, group
        in bars.groupby(
            "ticker"
        )
    }

    predictions_by_date = {
        date: group
        for date, group
        in predictions.groupby(
            "exec_date"
        )
    }

    # ========================================================
    # DAILY LOOP
    # ========================================================

    for day in market_dates:

        # ----------------------------------------------------
        # Mark existing positions
        # ----------------------------------------------------

        for ticker, position in list(
            positions.items()
        ):

            group = grouped[
                ticker
            ]

            row = group[
                group["date"] == day
            ]

            if row.empty:
                continue

            bar = row.iloc[0]

            position[
                "last_price"
            ] = float(
                bar["close"]
            )

        # ----------------------------------------------------
        # Current equity
        # ----------------------------------------------------

        equity = (
            cash
            +
            sum(
                p["shares"]
                * p["last_price"]
                for p in positions.values()
            )
        )

        # ----------------------------------------------------
        # Manage open positions
        # ----------------------------------------------------

        for ticker in list(
            positions.keys()
        ):

            position = (
                positions[ticker]
            )

            group = grouped[
                ticker
            ]

            row = group[
                group["date"] == day
            ]

            if row.empty:
                continue

            bar = row.iloc[0]

            high = float(
                bar["high"]
            )

            low = float(
                bar["low"]
            )

            close = float(
                bar["close"]
            )

            exit_reason = None
            exit_price = None

            # Stop has priority if both
            # barriers are touched.
            if low <= position["stop"]:

                exit_reason = "stop"

                exit_price = (
                    position["stop"]
                )

            elif high >= position["target"]:

                exit_reason = "target"

                exit_price = (
                    position["target"]
                )

            elif (
                position["bars_held"]
                >= cfg.max_hold_bars
            ):

                exit_reason = "time"

                exit_price = close

            position[
                "bars_held"
            ] += 1

            if exit_reason:

                shares = (
                    position["shares"]
                )

                entry_price = (
                    position[
                        "entry_price"
                    ]
                )

                entry_value = (
                    position[
                        "entry_value"
                    ]
                )

                gross_pnl = (
                    exit_price
                    - entry_price
                ) * shares

                costs = (
                    entry_price
                    + exit_price
                ) * shares * _cost_rate(
                    cfg
                )

                pnl = (
                    gross_pnl
                    - costs
                )

                exit_proceeds = (
                    shares
                    * exit_price
                    * (
                        1
                        - _cost_rate(
                            cfg
                        )
                    )
                )

                cash += (
                    exit_proceeds
                )

                trade_return = (
                    pnl
                    /
                    max(
                        entry_value,
                        1e-9
                    )
                )

                recent_returns.append(
                    float(
                        trade_return
                    )
                )

                recent_returns = (
                    recent_returns[-50:]
                )

                trades.append(
                    {
                        "ticker":
                            ticker,

                        "entry_date":
                            position[
                                "entry_date"
                            ],

                        "exit_date":
                            day,

                        "entry_price":
                            entry_price,

                        "exit_price":
                            exit_price,

                        "shares":
                            shares,

                        "pnl":
                            pnl,

                        "return":
                            trade_return,

                        "reason":
                            exit_reason,

                        "fold":
                            position[
                                "fold"
                            ],
                    }
                )

                del positions[
                    ticker
                ]

        # ----------------------------------------------------
        # Equity after exits
        # ----------------------------------------------------

        equity = (
            cash
            +
            sum(
                p["shares"]
                * p["last_price"]
                for p in positions.values()
            )
        )

        previous_peak = max(
            [
                row["equity"]
                for row in equity_rows
            ],
            default=equity
        )

        drawdown = (
            1
            -
            equity
            /
            max(
                previous_peak,
                equity
            )
        )

        drawdown_factor = max(
            cfg.drawdown_risk_floor,
            1
            - drawdown * 1.8
        )

        # ----------------------------------------------------
        # New candidates
        # ----------------------------------------------------

        candidates = (
            predictions_by_date.get(
                day
            )
        )

        if (
            candidates is not None
            and len(positions)
            < cfg.max_positions
        ):

            candidates = (
                candidates[
                    (
                        candidates[
                            "prob_up"
                        ]
                        >=
                        cfg.min_probability
                    )
                    &
                    (
                        candidates[
                            "expected_return"
                        ]
                        >=
                        cfg.min_expected_return
                    )
                ]
                .copy()
            )

            candidates = (
                candidates
                .sort_values(
                    "score",
                    ascending=False
                )
                .drop_duplicates(
                    "ticker"
                )
            )

            # ------------------------------------------------
            # Cross-sectional ranking
            # ------------------------------------------------

            for _, signal in (
                candidates.iterrows()
            ):

                if (
                    signal["ticker"]
                    in positions
                ):
                    continue

                if (
                    len(positions)
                    >= cfg.max_positions
                ):
                    break

                ticker = (
                    signal["ticker"]
                )

                group = grouped.get(
                    ticker
                )

                if group is None:
                    continue

                row = group[
                    group["date"] == day
                ]

                if row.empty:
                    continue

                bar = row.iloc[0]

                entry_price = float(
                    bar["open"]
                )

                atr = float(
                    bar["atr_14"]
                )

                if not np.isfinite(
                    atr
                ):

                    atr = (
                        entry_price
                        * 0.02
                    )

                stop_distance = max(
                    cfg.atr_stop * atr,
                    entry_price * 0.005
                )

                stop = (
                    entry_price
                    - stop_distance
                )

                target = (
                    entry_price
                    + cfg.atr_target * atr
                )

                if stop <= 0:
                    continue

                # ------------------------------------------------
                # Risk sizing
                # ------------------------------------------------

                risk_fraction = (
                    _kelly_risk(
                        recent_returns,
                        float(
                            signal[
                                "expected_return"
                            ]
                        ),
                        cfg,
                    )
                    * drawdown_factor
                )

                risk_cash = (
                    equity
                    * risk_fraction
                )

                shares_by_risk = (
                    risk_cash
                    / stop_distance
                )

                # Single position cap
                max_value = (
                    equity
                    * cfg.max_single_weight
                )

                shares_by_weight = (
                    max_value
                    / entry_price
                )

                current_exposure = sum(
                    p["shares"]
                    * p["last_price"]
                    for p in positions.values()
                )

                remaining_exposure = max(
                    0.0,
                    equity
                    * cfg.max_total_exposure
                    - current_exposure
                )

                shares_by_exposure = (
                    remaining_exposure
                    / entry_price
                )

                shares = math.floor(
                    max(
                        0.0,
                        min(
                            shares_by_risk,
                            shares_by_weight,
                            shares_by_exposure,
                        )
                    )
                )

                if shares < 1:
                    continue

                # ------------------------------------------------
                # Cash check
                # ------------------------------------------------

                entry_cost = (
                    entry_price
                    * shares
                    * _cost_rate(cfg)
                )

                total_cost = (
                    entry_price
                    * shares
                    + entry_cost
                )

                if total_cost > cash:

                    shares = math.floor(
                        cash
                        /
                        (
                            entry_price
                            * (
                                1
                                + _cost_rate(
                                    cfg
                                )
                            )
                        )
                    )

                if shares < 1:
                    continue

                total_cost = (
                    entry_price
                    * shares
                    * (
                        1
                        + _cost_rate(
                            cfg
                        )
                    )
                )

                cash -= total_cost

                positions[ticker] = {

                    "shares":
                        shares,

                    "entry_price":
                        entry_price,

                    "entry_value":
                        entry_price
                        * shares,

                    "entry_date":
                        day,

                    "last_price":
                        entry_price,

                    "stop":
                        stop,

                    "target":
                        target,

                    "bars_held":
                        0,

                    "fold":
                        int(
                            signal[
                                "fold"
                            ]
                        ),
                }

        # ----------------------------------------------------
        # End-of-day equity
        # ----------------------------------------------------

        equity = (
            cash
            +
            sum(
                p["shares"]
                * p["last_price"]
                for p in positions.values()
            )
        )

        equity_rows.append(
            {
                "date":
                    day,

                "equity":
                    equity,

                "cash":
                    cash,

                "positions":
                    len(positions),
            }
        )

    # ========================================================
    # FORCE CLOSE AT END OF DATA
    # ========================================================

    for ticker, position in list(
        positions.items()
    ):

        group = grouped[
            ticker
        ]

        last_bar = group.iloc[-1]

        exit_date = (
            last_bar["date"]
        )

        exit_price = float(
            last_bar["close"]
        )

        shares = (
            position["shares"]
        )

        entry_price = (
            position["entry_price"]
        )

        entry_value = (
            position["entry_value"]
        )

        gross_pnl = (
            exit_price
            - entry_price
        ) * shares

        costs = (
            entry_price
            + exit_price
        ) * shares * _cost_rate(
            cfg
        )

        pnl = (
            gross_pnl
            - costs
        )

        trade_return = (
            pnl
            /
            max(
                entry_value,
                1e-9
            )
        )

        trades.append(
            {
                "ticker":
                    ticker,

                "entry_date":
                    position[
                        "entry_date"
                    ],

                "exit_date":
                    exit_date,

                "entry_price":
                    entry_price,

                "exit_price":
                    exit_price,

                "shares":
                    shares,

                "pnl":
                    pnl,

                "return":
                    trade_return,

                "reason":
                    "end_of_data",

                "fold":
                    position[
                        "fold"
                    ],
            }
        )

    return (
        pd.DataFrame(
            equity_rows
        ),
        pd.DataFrame(
            trades
        ),
    )


# ============================================================
# PERFORMANCE
# ============================================================

def performance_metrics(
    equity: pd.DataFrame,
    trades: pd.DataFrame,
    initial: float,
):

    if equity.empty:
        return {}

    e = (
        equity
        .sort_values("date")
        .copy()
    )

    curve = (
        e["equity"]
        .astype(float)
    )

    total_return = (
        curve.iloc[-1]
        / initial
        - 1
    )

    days = max(
        (
            e["date"].iloc[-1]
            - e["date"].iloc[0]
        ).days,
        1
    )

    years = (
        days / 365.25
    )

    if curve.iloc[-1] > 0:

        cagr = (
            curve.iloc[-1]
            / initial
        ) ** (
            1 / years
        ) - 1

    else:

        cagr = -1

    peak = (
        curve
        .cummax()
    )

    drawdown = (
        curve
        / peak
        - 1
    )

    returns = (
        curve
        .pct_change()
        .replace(
            [np.inf, -np.inf],
            np.nan
        )
        .dropna()
    )

    if (
        len(returns) > 1
        and returns.std() > 0
    ):

        sharpe = (
            np.sqrt(252)
            * returns.mean()
            / returns.std()
        )

    else:

        sharpe = np.nan

    if trades.empty:

        profit_factor = np.nan
        win_rate = np.nan
        average_trade = np.nan

    else:

        wins = trades.loc[
            trades["pnl"] > 0,
            "pnl"
        ]

        losses = trades.loc[
            trades["pnl"] < 0,
            "pnl"
        ]

        if len(losses):

            profit_factor = (
                wins.sum()
                /
                abs(
                    losses.sum()
                )
            )

        else:

            profit_factor = np.inf

        win_rate = (
            trades["pnl"] > 0
        ).mean()

        average_trade = (
            trades["return"]
            .mean()
        )

    return {

        "End Capital":
            float(
                curve.iloc[-1]
            ),

        "Total Return":
            float(
                total_return
            ),

        "CAGR":
            float(
                cagr
            ),

        "Max Drawdown":
            float(
                drawdown.min()
            ),

        "Sharpe":
            (
                float(sharpe)
                if np.isfinite(sharpe)
                else np.nan
            ),

        "Profit Factor":
            (
                float(
                    profit_factor
                )
                if np.isfinite(
                    profit_factor
                )
                else profit_factor
            ),

        "Win Rate":
            (
                float(win_rate)
                if np.isfinite(
                    win_rate
                )
                else np.nan
            ),

        "Trades":
            int(
                len(trades)
            ),

        "Avg Trade Return":
            (
                float(
                    average_trade
                )
                if np.isfinite(
                    average_trade
                )
                else np.nan
            ),
    }


# ============================================================
# BENCHMARKS
# ============================================================

def build_benchmarks(
    panel: pd.DataFrame,
    benchmark_df: pd.DataFrame,
    initial: float,
):

    dates = (
        pd.DatetimeIndex(
            sorted(
                panel["date"].unique()
            )
        )
    )

    curves = pd.DataFrame(
        index=dates
    )

    # --------------------------------------------------------
    # Equal-weight universe
    # --------------------------------------------------------

    pivot = (
        panel
        .pivot_table(
            index="date",
            columns="ticker",
            values="close",
        )
        .reindex(dates)
        .ffill()
    )

    normalized = (
        pivot
        / pivot.iloc[0]
    )

    curves[
        "Equal Weight"
    ] = (
        normalized
        .mean(axis=1)
        * initial
    )

    # --------------------------------------------------------
    # Benchmark
    # --------------------------------------------------------

    benchmark = (
        benchmark_df
        .set_index("date")[
            "close"
        ]
        .reindex(dates)
        .ffill()
    )

    curves[
        "Benchmark"
    ] = (
        benchmark
        / benchmark.iloc[0]
        * initial
    )

    return curves.reset_index(
        names="date"
    )


# ============================================================
# MAIN ENGINE
# ============================================================

def run_engine(
    cfg: Config
):

    if not cfg.tickers:

        raise ValueError(
            "At least one ticker "
            "is required."
        )

    # --------------------------------------------------------
    # Benchmark
    # --------------------------------------------------------

    benchmark = download_ohlcv(
        cfg.benchmark,
        cfg.start,
        cfg.end
    )

    assets = []
    errors = []

    # --------------------------------------------------------
    # Assets
    # --------------------------------------------------------

    for ticker in cfg.tickers:

        try:

            data = download_ohlcv(
                ticker,
                cfg.start,
                cfg.end
            )

            if len(data) >= 250:

                features = make_features(
                    data,
                    benchmark
                )

                assets.append(
                    features
                )

            else:

                errors.append(
                    f"{ticker}: "
                    f"only {len(data)} bars"
                )

        except Exception as exc:

            errors.append(
                f"{ticker}: "
                f"{type(exc).__name__}: "
                f"{exc}"
            )

    if not assets:

        raise RuntimeError(
            "No asset data could "
            "be loaded. "
            + " | ".join(errors)
        )

    # --------------------------------------------------------
    # Panel
    # --------------------------------------------------------

    panel = make_labels(
        pd.concat(
            assets,
            ignore_index=True
        ),
        cfg.horizon_days,
        cfg.atr_stop,
        cfg.atr_target,
    )

    # --------------------------------------------------------
    # Walk Forward
    # --------------------------------------------------------

    predictions, diagnostics = (
        walk_forward(
            panel,
            cfg
        )
    )

    # --------------------------------------------------------
    # Backtest
    # --------------------------------------------------------

    equity, trades = backtest(
        predictions,
        panel,
        cfg
    )

    # --------------------------------------------------------
    # Metrics
    # --------------------------------------------------------

    metrics = performance_metrics(
        equity,
        trades,
        cfg.initial_capital
    )

    # --------------------------------------------------------
    # Benchmarks
    # --------------------------------------------------------

    benchmarks = build_benchmarks(
        panel,
        benchmark,
        cfg.initial_capital
    )

    return {

        "config":
            asdict(cfg),

        "panel":
            panel,

        "predictions":
            predictions,

        "equity":
            equity,

        "trades":
            trades,

        "metrics":
            metrics,

        "benchmarks":
            benchmarks,

        "diagnostics":
            diagnostics,

        "errors":
            errors,
    }
